<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>
      Application Received
    </title>

    <!--
      METHOD 1: <link> tag
      Works for Apple Mail, iOS Mail, etc.
    -->
    <!--[if !mso]><!-->
    <link
      href="https://fonts.googleapis.com/css2?family=Caprasimo&family=Karla:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />
    <!--<![endif]-->

    <style>
      /* METHOD 2: @import
                                This is a fallback for clients like Gmail that prefer @import.
                              */
      
      @import url('https://fonts.googleapis.com/css2?family=Caprasimo&family=Karla:ital,wght@0,200..800;1,200..800&display=swap');
      
      /* Responsive Styles
                                Gmail supports media queries. We set the mobile-first styles
                                inline, and then use media queries to override them on desktop.
                              */
      
      @media only screen and (min-width: 600px) {
        .heading {
          font-size: 30px !important;
        }
      
        .subheading {
          font-size: 25px !important;
        }
      }
    </style>
  </head>
  <body
    style="margin: 0; padding: 0; background-color: #f1ede0; font-family: 'Karla', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.5; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;"
  >
    <!--
      Outer wrapper table.
      This centers the content and sets the main background color.
    -->
    <table
      role="presentation"
      cellspacing="0"
      cellpadding="0"
      border="0"
      width="100%"
      style="background-color: #f1ede0; border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt;"
    >
      <tr>
        <td align="center" style="padding: 0;">

          <!--
            Main content table.
            Set to 600px width for desktop, which is the standard
            safe width for email.
          -->
          <table
            role="presentation"
            cellspacing="0"
            cellpadding="0"
            border="0"
            width="100%"
            style="max-width: 600px; border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt;"
          >

            <!--
              Row 1: Top spacing and "Knock Knock" Image.
              We use padding-top on the <td> for spacing.
            -->
            <tr>
              <td align="center" style="padding: 135px 32px 0 32px;">
                <img
                  src="https://res.cloudinary.com/redeem/image/upload/v1762483653/dev/Knock_Knock_trbiaj.png"
                  alt="Knock Knock"
                  width="300"
                  style="display: block; border: 0; max-width: 100%; height: auto;"
                />
              </td>
            </tr>

            <!--
              Row 2: Heading text.
              All styles (font, color, weight, size) are inlined.
              The 'heading' class is for the responsive override.
            -->
            <tr>
              <td align="center" style="padding: 74px 32px 0 32px;">
                <p
                  class="heading"
                  style="margin: 0; font-family: 'Karla', Arial, sans-serif; font-size: 20px; font-weight: 600; color: #0056c9; text-align: center; max-width: 465px; line-height: 1.5;"
                >
                  We have your application for Community Welcome.
                </p>
              </td>
            </tr>

            <!--
              Row 3: Subheading text.
              Padding-top is 16px (from your mt-4 class).
            -->
            <tr>
              <td align="center" style="padding: 16px 32px 0 32px;">
                <p
                  class="subheading"
                  style="margin: 0; font-family: 'Karla', Arial, sans-serif; font-size: 17px; color: #0056c9; text-align: center; max-width: 376px; line-height: 150%;"
                >
                  We'll be in touch shortly if your application is approved.
                </p>
              </td>
            </tr>

            <!--
              Row 4: Footer Wave Image.
              Padding-top is 144px (from your mt-36 class).
              Set to width: 100% to act as a proper footer divider.
            -->
            <tr>
              <td style="padding-top: 144px;">
                <img
                  src="https://res.cloudinary.com/redeem/image/upload/v1762483434/dev/wave-combined_o5uxnh.png"
                  alt=""
                  width="600"
                  style="display: block; border: 0; width: 100%; height: auto;"
                />
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
