<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Registration Confirmed</title>
    <!--[if !mso]><!-->
    <link
      href="https://fonts.googleapis.com/css2?family=Caprasimo&family=Karla:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />
    <!--<![endif]-->
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Caprasimo&family=Karla:ital,wght@0,200..800;1,200..800&display=swap');
      @media only screen and (min-width: 600px) {
        .heading { font-size: 30px !important; }
        .subheading { font-size: 25px !important; }
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f1ede0; font-family: 'Karla', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.5;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f1ede0; border-collapse: collapse;">
      <tr>
        <td align="center" style="padding: 0;">
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 600px; border-collapse: collapse;">
            <tr>
              <td align="center" style="padding: 135px 32px 0 32px;">
                <img
                  src="https://res.cloudinary.com/redeem/image/upload/v1762483653/dev/Knock_Knock_trbiaj.png"
                  alt="Good Directions"
                  width="300"
                  style="display: block; border: 0; max-width: 100%; height: auto;"
                />
              </td>
            </tr>
            <tr>
              <td align="center" style="padding: 74px 32px 0 32px;">
                <p class="heading" style="margin: 0; font-family: 'Karla', Arial, sans-serif; font-size: 20px; font-weight: 600; color: #6d3b90; text-align: center; max-width: 465px; line-height: 1.5;">
                  Thank you for registering for your NDIS Healthcheck, {{ respondent.name }}.
                </p>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding: 16px 32px 0 32px;">
                <p class="subheading" style="margin: 0; font-family: 'Karla', Arial, sans-serif; font-size: 17px; color: #6d3b90; text-align: center; max-width: 376px; line-height: 150%;">
                  We'll be in touch shortly to arrange your healthcheck.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding-top: 144px;">
                <img
                  src="https://res.cloudinary.com/redeem/image/upload/v1762483434/dev/wave-combined_o5uxnh.png"
                  alt=""
                  width="600"
                  style="display: block; border: 0; width: 100%; height: auto;"
                />
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
