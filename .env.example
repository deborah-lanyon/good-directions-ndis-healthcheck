# Example environment file for local development
# Copy this to `.env` and fill values before running the app.

NODE_ENV=development
APP_KEY=
HOST=127.0.0.1
APP_URL=http://localhost:3333
LOG_LEVEL=info
PORT=3333
TZ=UTC

SESSION_DRIVER=cookie

# Development Admin User (for seeders - only used in development)
# In production, create admin users via: node ace make:super_admin <email>
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=password123
DEV_ADMIN_NAME=Dev Admin

# Database (used by Adonis config)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=welcomers_user
DB_PASSWORD=welcomers_pass
DB_DATABASE=welcomers_dev

# Geocode API
GEOCODE_API_KEY=your_geocode_key_here

# Zyla API (Australia Property Search)
ZYLA_API_KEY=your_zyla_api_key_here

# Google Maps API (for route planning - optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Cloud Storage (for welcome pack images - optional)
GCP_PROJECT_ID=
GCS_BUCKET_NAME=

# SMTP Email Configuration
# For local development with MailHog (included in docker-compose.yml):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Optional: Override email from address (defaults to noreply@welcomers-portal.com)
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# For production with Mailgun:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@mg.communitywelcome.org.au
# SMTP_PASSWORD=your_mailgun_smtp_password_here
# ADMIN_EMAIL=deborah@gooddirections.com.au
# MAIL_FROM_ADDRESS=deborah@gooddirections.com.au
# MAIL_FROM_NAME=Community Welcome Portal